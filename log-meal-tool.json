      "id": "c6a6c567-3e8a-424f-8fb8-91ac52023924",
      "name": "Read User1",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        576,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "const request = $('Execute Workflow Trigger').first().json;\nconst user = $('Read User1').first().json;\nconst meals = $input.all().map(item => item.json);\n\nfunction toNumber(value) {\n  if (typeof value === 'number') {\n    return Number.isFinite(value) ? value : 0;\n  }\n\n  const normalized = String(value ?? 0)\n    .replace(/[٠-٩]/g, digit => String('٠١٢٣٤٥٦٧٨٩'.indexOf(digit)))\n    .replace(/[۰-۹]/g, digit => String('۰۱۲۳۴۵۶۷۸۹'.indexOf(digit)))\n    .replace(/٫/g, '.')\n    .replace(/٬/g, '')\n    .replace(/,/g, '')\n    .trim();\n\n  const result = Number(normalized);\n  return Number.isFinite(result) ? result : 0;\n}\n\nfunction round(value) {\n  return Math.round(value * 10) / 10;\n}\n\n// جمع كل وجبات اليوم الموجودة في log meal\nconst totals = meals.reduce((total, meal) => {\n  total.calories += toNumber(meal.calories);\n  total.protein += toNumber(meal.protein);\n  total.carbs += toNumber(meal.carbs);\n  total.fat += toNumber(meal.fat);\n  return total;\n}, {\n  calories: 0,\n  protein: 0,\n  carbs: 0,\n  fat: 0\n});\n\ntotals.calories = round(totals.calories);\ntotals.protein = round(totals.protein);\ntotals.carbs = round(totals.carbs);\ntotals.fat = round(totals.fat);\n\nconst caloriesTarget = toNumber(user.calories_target);\nconst proteinTarget = toNumber(user.protein_target);\nconst carbsTarget = toNumber(user.carbs_target);\nconst fatTarget = toNumber(user.fat_target);\n\nconst today = new Intl.DateTimeFormat('en-CA', {\n  timeZone: 'Asia/Damascus',\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit'\n}).format(new Date());\n\nreturn [{\n  json: {\n    user_update: {\n      user_id: user.user_id,\n\n      calories_today: totals.calories,\n      protein_today: totals.protein,\n      carbs_today: totals.carbs,\n      fat_today: totals.fat,\n\n      calories_left: round(caloriesTarget - totals.calories),\n      protein_left: round(proteinTarget - totals.protein),\n      carbs_left: round(carbsTarget - totals.carbs),\n      fat_left: round(fatTarget - totals.fat),\n\n      last_date: today\n    },\n\n    meal_log: {\n      user_id: user.user_id,\n      meal_name: request.meal_name,\n      calories: toNumber(request.calories),\n      protein: toNumber(request.protein),\n      carbs: toNumber(request.carbs),\n      fat: toNumber(request.fat)\n    }\n  }\n}];"
      },
      "id": "9a0aba7d-c706-4e4b-acd9-9ebcd90a2bdb",
      "name": "Calculate Totals1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        -64
      ]
    },
    {
      "parameters": {
        "jsCode": "const calc = $('Calculate Totals1').first().json;\n\nreturn [{\n  json: {\n    success: true,\n\n    user_id: calc.user_update.user_id,\n\n    meal_name: calc.meal_log.meal_name,\n    meal_calories: Number(calc.meal_log.calories),\n    meal_protein: Number(calc.meal_log.protein),\n    meal_carbs: Number(calc.meal_log.carbs),\n    meal_fat: Number(calc.meal_log.fat),\n\n    calories_today: Number(calc.user_update.calories_today),\n    calories_left: Number(calc.user_update.calories_left),\n\n    protein_left: Number(calc.user_update.protein_left),\n    carbs_left: Number(calc.user_update.carbs_left),\n    fat_left: Number(calc.user_update.fat_left)\n  }\n}];"
      },
