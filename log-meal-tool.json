    {
      "parameters": {
        "jsCode": "const request = $('Execute Workflow Trigger').first().json;\n\nconst rows = $input.all()\n  .map(item => item.json)\n  .filter(row => row.created_at);\n\nconst now = Date.now();\nconst tenMinutes = 10 * 60 * 1000;\n\nconst recentMeal = rows.find(row => {\n  const createdAt = Date.parse(\n    String(row.created_at || '').trim()\n  );\n\n  if (!Number.isFinite(createdAt)) {\n    return false;\n  }\n\n  const difference = now - createdAt;\n\n  return difference >= 0 && difference <= tenMinutes;\n});\n\nreturn [{\n  json: {\n    duplicate: Boolean(recentMeal),\n    user_id: request.user_id,\n    meal_name: recentMeal?.meal_name || request.meal_name || '',\n    message_id: recentMeal?.message_id || '',\n    created_at: recentMeal?.created_at || ''\n  }\n}];"
      },
